<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Traza por consola con nivel INFO por defecto, DEBUG para el codigo propio del banco. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Codigo propio: DEBUG habilitado para poder trazar reglas de negocio en desarrollo. -->
    <logger name="com.banco" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Spring Data Mongo reactivo: WARN para no saturar la traza con cada query. -->
    <logger name="org.springframework.data.mongodb" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
